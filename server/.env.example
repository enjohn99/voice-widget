# Copy to .env (or export in your shell). Every value is OPTIONAL; omit to use config.json / localhost defaults.
# Precedence: GUI settings panel (writes config.json) > config.json > these env vars > built-in localhost defaults.

# --- server ---
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8730
# BRIDGE_CONFIG=/absolute/path/to/config.json

# --- auth (default: fully local, no token) ---
# BRIDGE_TOKEN=some-shared-secret        # setting this turns on token auth (sent as X-Bridge-Token header)

# --- Kokoro TTS ---
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=1.0
# KOKORO_DEVICE=auto                      # auto|mps|cpu
# KOKORO_MODEL_DIR=~/.voice-loop/models/Kokoro-82M
# VOICE_LOOP_PATH=/path/to/voice-loop/voice_loop.py   # reuse the existing voice-loop Kokoro class verbatim

# --- STT (browser WASM model id served to the widget) ---
# STT_MODEL_ID=onnx-community/whisper-base

# --- agent session bindings (JSON array; overrides config.json 'agents') ---
# BRIDGE_AGENTS=[{"id":"work","name":"Work repo","cmd":"pi --mode json {text}","mode":"pi-json","cwd":"/path/work"},{"id":"personal","name":"Personal","cmd":"pi --mode json {text}","mode":"pi-json","cwd":"/path/home"}]

# --- Windows only: espeak-ng location (separately installed, GPL-3.0). NO quotes around values. ---
# The bridge auto-detects C:\Program Files\eSpeak NG; set these only for a non-default install.
# PHONEMIZER_ESPEAK_LIBRARY=C:\Program Files\eSpeak NG\libespeak-ng.dll
# PHONEMIZER_ESPEAK_PATH=C:\Program Files\eSpeak NG\espeak-ng.exe
